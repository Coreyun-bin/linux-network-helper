cat <<EOF > src/main.py
import os
import socket
import subprocess
import sys

def get_local_ip():
    try:
        hostname = socket.gethostname()
        local_ip = socket.gethostbyname(hostname)
        return local_ip
    except Exception as e:
        return str(e)

def ping_host(host):
    param = '-n' if platform.system().lower()=='windows' else '-c'
    command = ['ping', param, '1', host]
    return subprocess.call(command) == 0

def main():
    print("--- Linux Network Helper v1.0 ---")
    print(f"Local IP: {get_local_ip()}")
    
    target = "google.com"
    print(f"\nChecking connection to {target}...")
    if ping_host(target):
        print(f"{target} is UP!")
    else:
        print(f"{target} is DOWN!")

if _name_ == "_main_":
    import platform
    main()
EOF

